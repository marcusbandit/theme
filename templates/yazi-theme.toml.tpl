# Generated by theme-set.
[mgr]
cwd = { fg = "{{ accent }}" }
hovered = { fg = "{{ background }}", bg = "{{ accent }}" }
preview_hovered = { underline = true }
find_keyword = { fg = "{{ yellow }}", bold = true }
marker_selected = { fg = "{{ green }}", bg = "{{ green }}" }
marker_cut = { fg = "{{ red }}", bg = "{{ red }}" }
tab_active = { fg = "{{ background }}", bg = "{{ accent }}" }
tab_inactive = { fg = "{{ foreground }}", bg = "{{ selection }}" }
border_style = { fg = "{{ muted }}" }

[mode]
normal_main = { fg = "{{ background }}", bg = "{{ accent }}", bold = true }
select_main = { fg = "{{ background }}", bg = "{{ green }}", bold = true }
unset_main  = { fg = "{{ background }}", bg = "{{ magenta }}", bold = true }

[status]
progress_label = { fg = "{{ bright_foreground }}", bold = true }
progress_normal = { fg = "{{ accent }}", bg = "{{ selection }}" }
progress_error = { fg = "{{ red }}", bg = "{{ selection }}" }

[input]
border = { fg = "{{ accent }}" }

[pick]
border = { fg = "{{ accent }}" }
active = { fg = "{{ magenta }}", bold = true }

[confirm]
border = { fg = "{{ accent }}" }
