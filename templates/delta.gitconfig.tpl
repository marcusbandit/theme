# Generated by theme-set. Included from ~/.gitconfig.
[delta]
    minus-style                   = normal "{{ mix red background 82% }}"
    minus-non-emph-style          = normal "{{ mix red background 82% }}"
    minus-emph-style              = normal "{{ mix red background 62% }}"
    plus-style                    = normal "{{ mix green background 82% }}"
    plus-non-emph-style           = normal "{{ mix green background 82% }}"
    plus-emph-style               = normal "{{ mix green background 62% }}"
    line-numbers-minus-style      = "{{ red }}"
    line-numbers-plus-style       = "{{ green }}"
    line-numbers-zero-style       = "{{ muted }}"
    line-numbers-left-style       = "{{ muted }}"
    line-numbers-right-style      = "{{ muted }}"
    file-style                    = bold "{{ accent }}"
    file-decoration-style         = "{{ muted }}" ul
    hunk-header-style             = "{{ dark_foreground }}"
    hunk-header-decoration-style  = "{{ muted }}" box
    blame-palette                 = "{{ background }} {{ ramp_dark }} {{ ramp_plate }} {{ selection }}"
