# Generated by theme-set. A tinted-theming common scheme file, so this palette
# also drives the base16/base24 template ecosystem (tinty, tinted-builder).
system: "base24"
name: "{{ theme_name }}"
slug: "{{ theme_name }}"
author: "bandit"
variant: "{{ mode }}"
palette:
  base00: "{{ background }}"
  base01: "{{ lighter_background }}"
  base02: "{{ selection }}"
  base03: "{{ muted }}"
  base04: "{{ dark_foreground }}"
  base05: "{{ foreground }}"
  base06: "{{ light_foreground }}"
  base07: "{{ bright_foreground }}"
  base08: "{{ red }}"
  base09: "{{ orange }}"
  base0A: "{{ yellow }}"
  base0B: "{{ green }}"
  base0C: "{{ cyan }}"
  base0D: "{{ blue }}"
  base0E: "{{ magenta }}"
  base0F: "{{ brown }}"
  base10: "{{ dark_background }}"
  base11: "{{ darker_background }}"
  base12: "{{ bright_red }}"
  base13: "{{ bright_yellow }}"
  base14: "{{ bright_green }}"
  base15: "{{ bright_cyan }}"
  base16: "{{ bright_blue }}"
  base17: "{{ bright_magenta }}"
