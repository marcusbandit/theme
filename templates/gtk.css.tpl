/* Generated by theme-set. Do not edit; edit themes/<name>/colors.toml.
 *
 * This one file serves GTK3 and GTK4. ~/.config/gtk-3.0/gtk.css and
 * ~/.config/gtk-4.0/gtk.css both point here.
 *
 * IMPORTANT: libadwaita ignores every one of these if GTK_THEME is set in the
 * environment. GTK_THEME must stay unset for this file to do anything. */

@define-color accent_color            {{ accent }};
@define-color accent_bg_color         {{ accent }};
@define-color accent_fg_color         {{ background }};

@define-color destructive_color       {{ red }};
@define-color destructive_bg_color    {{ red }};
@define-color destructive_fg_color    {{ background }};

@define-color success_color           {{ green }};
@define-color success_bg_color        {{ green }};
@define-color success_fg_color        {{ background }};

@define-color warning_color           {{ orange }};
@define-color warning_bg_color        {{ orange }};
@define-color warning_fg_color        {{ background }};

@define-color error_color             {{ red }};
@define-color error_bg_color          {{ red }};
@define-color error_fg_color          {{ background }};

@define-color window_bg_color         {{ ramp_plate }};
@define-color window_fg_color         {{ foreground }};

@define-color view_bg_color           {{ background }};
@define-color view_fg_color           {{ foreground }};

@define-color headerbar_bg_color      {{ ramp_dark }};
@define-color headerbar_fg_color      {{ foreground }};
@define-color headerbar_border_color  {{ muted }};
@define-color headerbar_backdrop_color {{ ramp_plate }};
@define-color headerbar_shade_color   {{ ramp_void }};

@define-color card_bg_color           {{ ramp_dark }};
@define-color card_fg_color           {{ foreground }};
@define-color card_shade_color        {{ ramp_void }};

@define-color dialog_bg_color         {{ ramp_plate }};
@define-color dialog_fg_color         {{ foreground }};

@define-color popover_bg_color        {{ ramp_dark }};
@define-color popover_fg_color        {{ foreground }};
@define-color popover_shade_color     {{ ramp_void }};

@define-color sidebar_bg_color        {{ ramp_dark }};
@define-color sidebar_fg_color        {{ foreground }};
@define-color sidebar_backdrop_color  {{ dark_background }};
@define-color sidebar_border_color    {{ muted }};
@define-color sidebar_shade_color     {{ ramp_void }};

@define-color secondary_sidebar_bg_color       {{ dark_background }};
@define-color secondary_sidebar_fg_color       {{ foreground }};
@define-color secondary_sidebar_backdrop_color {{ dark_background }};
@define-color secondary_sidebar_border_color   {{ muted }};
@define-color secondary_sidebar_shade_color    {{ ramp_void }};

@define-color thumbnail_bg_color      {{ ramp_dark }};
@define-color thumbnail_fg_color      {{ foreground }};

@define-color shade_color             {{ ramp_void }};
@define-color scrollbar_outline_color {{ muted }};

/* GTK3 legacy names. GTK3 apps that predate the libadwaita roles read these. */
@define-color theme_bg_color          {{ ramp_plate }};
@define-color theme_fg_color          {{ foreground }};
@define-color theme_base_color        {{ background }};
@define-color theme_text_color        {{ foreground }};
@define-color theme_selected_bg_color {{ accent }};
@define-color theme_selected_fg_color {{ background }};
@define-color insensitive_bg_color    {{ ramp_dark }};
@define-color insensitive_fg_color    {{ dark_foreground }};
@define-color borders                 {{ muted }};

/* Thunar-specific layout, same palette. */
@import "thunar.css";
