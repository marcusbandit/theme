# Generated by theme-set. Do not edit; edit themes/<name>/colors.toml.
#
# KDE apps (Kate, Dolphin, ...) colour their views through KColorScheme, which
# reads these sections from ~/.config/kdeglobals and ignores the qt6ct palette.
# With no file at all they fall back to stock Breeze, which is pure white.
# ~/.config/kdeglobals is a symlink to this file, and so is
# ~/.local/share/color-schemes/ThemePalette.colors: KDE apps look the scheme up
# by the name below and fall back to Breeze when no such file exists.

[General]
ColorScheme=ThemePalette
Name=ThemePalette

[Icons]
Theme={{ icons }}

[Colors:Window]
BackgroundNormal={{ ramp_plate_rgb }}
BackgroundAlternate={{ ramp_dark_rgb }}
ForegroundNormal={{ foreground_rgb }}
ForegroundInactive={{ dark_foreground_rgb }}
ForegroundActive={{ accent_rgb }}
ForegroundLink={{ accent_rgb }}
ForegroundVisited={{ magenta_rgb }}
ForegroundNegative={{ red_rgb }}
ForegroundNeutral={{ orange_rgb }}
ForegroundPositive={{ green_rgb }}
DecorationFocus={{ accent_rgb }}
DecorationHover={{ accent_dim_rgb }}

[Colors:View]
BackgroundNormal={{ background_rgb }}
BackgroundAlternate={{ mix_rgb background ramp_dark 50% }}
ForegroundNormal={{ foreground_rgb }}
ForegroundInactive={{ dark_foreground_rgb }}
ForegroundActive={{ accent_rgb }}
ForegroundLink={{ accent_rgb }}
ForegroundVisited={{ magenta_rgb }}
ForegroundNegative={{ red_rgb }}
ForegroundNeutral={{ orange_rgb }}
ForegroundPositive={{ green_rgb }}
DecorationFocus={{ accent_rgb }}
DecorationHover={{ accent_dim_rgb }}

[Colors:Button]
BackgroundNormal={{ ramp_body_rgb }}
BackgroundAlternate={{ ramp_plate_rgb }}
ForegroundNormal={{ foreground_rgb }}
ForegroundInactive={{ dark_foreground_rgb }}
ForegroundActive={{ accent_rgb }}
ForegroundLink={{ accent_rgb }}
ForegroundVisited={{ magenta_rgb }}
ForegroundNegative={{ red_rgb }}
ForegroundNeutral={{ orange_rgb }}
ForegroundPositive={{ green_rgb }}
DecorationFocus={{ accent_rgb }}
DecorationHover={{ accent_dim_rgb }}

[Colors:Selection]
# A tint of the accent under ordinary text, not text on solid accent: KDE
# views draw this blended over the base, and full-strength text keeps its
# contrast on a tint in both modes.
BackgroundNormal={{ mix_rgb background accent 35% }}
BackgroundAlternate={{ mix_rgb background accent 22% }}
ForegroundNormal={{ bright_foreground_rgb }}
ForegroundInactive={{ foreground_rgb }}
ForegroundActive={{ accent_bright_rgb }}
ForegroundLink={{ accent_bright_rgb }}
ForegroundVisited={{ magenta_rgb }}
ForegroundNegative={{ red_rgb }}
ForegroundNeutral={{ orange_rgb }}
ForegroundPositive={{ green_rgb }}
DecorationFocus={{ accent_rgb }}
DecorationHover={{ accent_dim_rgb }}

[Colors:Tooltip]
BackgroundNormal={{ ramp_dark_rgb }}
BackgroundAlternate={{ ramp_plate_rgb }}
ForegroundNormal={{ foreground_rgb }}
ForegroundInactive={{ dark_foreground_rgb }}
ForegroundActive={{ accent_rgb }}
ForegroundLink={{ accent_rgb }}
ForegroundVisited={{ magenta_rgb }}
ForegroundNegative={{ red_rgb }}
ForegroundNeutral={{ orange_rgb }}
ForegroundPositive={{ green_rgb }}
DecorationFocus={{ accent_rgb }}
DecorationHover={{ accent_dim_rgb }}

[Colors:Header]
BackgroundNormal={{ ramp_dark_rgb }}
BackgroundAlternate={{ ramp_plate_rgb }}
ForegroundNormal={{ foreground_rgb }}
ForegroundInactive={{ dark_foreground_rgb }}
ForegroundActive={{ accent_rgb }}
ForegroundLink={{ accent_rgb }}
ForegroundVisited={{ magenta_rgb }}
ForegroundNegative={{ red_rgb }}
ForegroundNeutral={{ orange_rgb }}
ForegroundPositive={{ green_rgb }}
DecorationFocus={{ accent_rgb }}
DecorationHover={{ accent_dim_rgb }}

[Colors:Complementary]
BackgroundNormal={{ ramp_dark_rgb }}
BackgroundAlternate={{ ramp_plate_rgb }}
ForegroundNormal={{ foreground_rgb }}
ForegroundInactive={{ dark_foreground_rgb }}
ForegroundActive={{ accent_rgb }}
ForegroundLink={{ accent_rgb }}
ForegroundVisited={{ magenta_rgb }}
ForegroundNegative={{ red_rgb }}
ForegroundNeutral={{ orange_rgb }}
ForegroundPositive={{ green_rgb }}
DecorationFocus={{ accent_rgb }}
