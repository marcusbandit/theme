    "black": "{{ background }}",   "brightBlack": "{{ muted }}",
    "red": "{{ red }}",            "brightRed": "{{ bright_red }}",
    "green": "{{ green }}",        "brightGreen": "{{ bright_green }}",
    "yellow": "{{ yellow }}",      "brightYellow": "{{ bright_yellow }}",
    "blue": "{{ blue }}",          "brightBlue": "{{ bright_blue }}",
    "magenta": "{{ magenta }}",    "brightMagenta": "{{ bright_magenta }}",
    "cyan": "{{ cyan }}",          "brightCyan": "{{ bright_cyan }}",
    "white": "{{ foreground }}",   "brightWhite": "{{ bright_foreground }}"
