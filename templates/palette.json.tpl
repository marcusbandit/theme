{
  "name": "{{ theme_name }}",
  "ramp": [
    "{{ ramp_void }}",
    "{{ ramp_abyss }}",
    "{{ ramp_dark }}",
    "{{ ramp_plate }}",
    "{{ ramp_body }}",
    "{{ ramp_brushed }}",
    "{{ ramp_edge }}",
    "{{ ramp_lit }}",
    "{{ ramp_pale }}",
    "{{ ramp_silver }}",
    "{{ ramp_chrome }}"
  ],
  "dim": "{{ accent_dim }}",
  "mid": "{{ accent_mid }}",
  "bright": "{{ accent_bright }}",
  "alarm": "{{ orange }}",
  "ice": "{{ metal_ice }}",
  "iceDim": "{{ metal_ice_dim }}",
  "brass": "{{ metal_brass }}",
  "brassDim": "{{ metal_brass_dim }}",
