# Generated by theme-set. Sourced from ~/.config/tmux/tmux.conf.
set -g status-style "bg=default,fg={{ dark_foreground }}"
set -g window-status-style default
set -g window-status-current-style default
set -g pane-border-style "fg={{ muted }}"
set -g pane-active-border-style "fg={{ accent }}"
set -g message-style "bg={{ accent }},fg={{ background }},bold"
set -g message-command-style "bg={{ accent }},fg={{ background }},bold"
set -g mode-style "bg={{ accent }},fg={{ background }}"
setw -g window-status-activity-style "fg={{ orange }}"
set -g display-panes-active-colour "{{ accent }}"
set -g display-panes-colour "{{ muted }}"
set -g clock-mode-colour "{{ accent }}"

# User options, so the status-line FORMAT strings can follow the theme too.
# Format strings are not style options, so they cannot be set from here; they
# interpolate these with #{@theme_accent} and friends.
set -g @theme_accent "{{ accent }}"
set -g @theme_dim    "{{ accent_dim }}"
set -g @theme_bg     "{{ background }}"
set -g @theme_fg     "{{ foreground }}"
set -g @theme_muted  "{{ dark_foreground }}"
set -g @theme_alarm  "{{ orange }}"
