# Generated by theme-set. Do not edit; edit templates/warp.yaml.tpl.
#
# Warp scans its themes directory at startup and has no include mechanism, so
# ~/.config/warp-terminal/themes/theme.yaml (and ~/.warp/themes/theme.yaml) are
# symlinks to this file. The entry shows up as "theme" in warp's picker; pick
# it once, the palette then follows theme-set. Warp cannot hot-reload it.

accent: "{{ accent }}"
background: "{{ background }}"
foreground: "{{ foreground }}"
details: darker

terminal_colors:
  normal:
    black: "{{ background }}"
    red: "{{ red }}"
    green: "{{ green }}"
    yellow: "{{ yellow }}"
    blue: "{{ blue }}"
    magenta: "{{ magenta }}"
    cyan: "{{ cyan }}"
    white: "{{ foreground }}"
  bright:
    black: "{{ muted }}"
    red: "{{ bright_red }}"
    green: "{{ bright_green }}"
    yellow: "{{ bright_yellow }}"
    blue: "{{ bright_blue }}"
    magenta: "{{ bright_magenta }}"
    cyan: "{{ bright_cyan }}"
    white: "{{ bright_foreground }}"
