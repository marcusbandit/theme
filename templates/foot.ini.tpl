# Generated by theme-set. Do not edit; edit templates/foot.ini.tpl.
#
# foot has no include mechanism, so this file IS the app config:
# ~/.config/foot/foot.ini is a symlink into current/. That means font, pad and
# transparency live here too. foot reads the file only at startup; colour
# changes to running windows ride in through theme-reload's escape-sequence
# repaint, anything else waits for the next launch.

font=JetBrainsMono Nerd Font:size=16
# kitty window_padding_width 0 0 8 0, i.e. 8px at the bottom only.
# LEFTxTOPxRIGHTxBOTTOM, per config.c; the man page order is wrong.
pad=0x0x0x8

[colors-dark]
alpha=0.9
background={{ background_strip }}
foreground={{ foreground_strip }}
selection-background={{ selection_strip }}
selection-foreground={{ bright_foreground_strip }}
cursor={{ background_strip }} {{ cursor_strip }}
regular0={{ background_strip }}
regular1={{ red_strip }}
regular2={{ green_strip }}
regular3={{ yellow_strip }}
regular4={{ blue_strip }}
regular5={{ magenta_strip }}
regular6={{ cyan_strip }}
regular7={{ foreground_strip }}
bright0={{ muted_strip }}
bright1={{ bright_red_strip }}
bright2={{ bright_green_strip }}
bright3={{ bright_yellow_strip }}
bright4={{ bright_blue_strip }}
bright5={{ bright_magenta_strip }}
bright6={{ bright_cyan_strip }}
bright7={{ bright_foreground_strip }}
