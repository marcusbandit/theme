-- Generated by theme-set. Do not edit; overwritten on every theme switch.
--
-- Neovim's slice of the palette. ~/.config/nvim/lua/bandit/theme.lua reads this
-- file at a fixed path and never learns a theme name, per the contract in
-- ~/.config/theme/README.md.
return {
  name = "{{ theme_name }}",
  mode = "{{ mode }}",

  -- The 16 base16 slots. mini.base16 expands these into the full highlight set.
  base00 = "{{ background }}",
  base01 = "{{ lighter_background }}",
  base02 = "{{ selection }}",
  base03 = "{{ muted }}",
  base04 = "{{ dark_foreground }}",
  base05 = "{{ foreground }}",
  base06 = "{{ light_foreground }}",
  base07 = "{{ bright_foreground }}",
  base08 = "{{ red }}",
  base09 = "{{ orange }}",
  base0A = "{{ yellow }}",
  base0B = "{{ green }}",
  base0C = "{{ cyan }}",
  base0D = "{{ blue }}",
  base0E = "{{ magenta }}",
  base0F = "{{ brown }}",

  -- base24 extends base16 with the bright ANSI half and two darker grounds.
  -- base16 has no slot for these, so :terminal gets its bright colours here.
  base10 = "{{ dark_background }}",
  base11 = "{{ darker_background }}",
  base12 = "{{ bright_red }}",
  base13 = "{{ bright_yellow }}",
  base14 = "{{ bright_green }}",
  base15 = "{{ bright_cyan }}",
  base16 = "{{ bright_blue }}",
  base17 = "{{ bright_magenta }}",

  -- Design-system extensions. base16 flattens everything into 16 slots; these
  -- keep the parts of the palette that carry meaning on their own.
  accent = "{{ accent }}",
  accent_dim = "{{ accent_dim }}",
  accent_mid = "{{ accent_mid }}",
  accent_bright = "{{ accent_bright }}",

  border_lit = "{{ border_lit }}",
  shadow = "{{ shadow }}",

  metal_ice = "{{ metal_ice }}",
  metal_ice_dim = "{{ metal_ice_dim }}",
  metal_brass = "{{ metal_brass }}",
  metal_brass_dim = "{{ metal_brass_dim }}",

  -- The 12 stop metal ramp, dark to light.
  ramp = {
    "{{ ramp_void }}",
    "{{ ramp_abyss }}",
    "{{ ramp_dark }}",
    "{{ ramp_plate }}",
    "{{ ramp_body }}",
    "{{ ramp_brushed }}",
    "{{ ramp_edge }}",
    "{{ ramp_lit }}",
    "{{ ramp_pale }}",
    "{{ ramp_silver }}",
    "{{ ramp_chrome }}",
    "{{ ramp_white }}",
  },
}
