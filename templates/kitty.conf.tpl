# Generated by theme-set. Do not edit; edit themes/<name>/colors.toml instead.
# kitty auto_reload_config is on by default since 0.47 and follows includes,
# so changing this file repaints open windows with no reload command.

background              {{ background }}
foreground              {{ foreground }}
cursor                  {{ cursor }}
cursor_text_color       {{ background }}

selection_background    {{ selection }}
selection_foreground    {{ bright_foreground }}
url_color               {{ accent }}

active_border_color     {{ accent }}
inactive_border_color   {{ muted }}
bell_border_color       {{ orange }}

active_tab_foreground   {{ background }}
active_tab_background   {{ accent }}
inactive_tab_foreground {{ dark_foreground }}
inactive_tab_background {{ lighter_background }}
tab_bar_background      {{ dark_background }}

mark1_foreground {{ background }}
mark1_background {{ accent }}
mark2_foreground {{ background }}
mark2_background {{ magenta }}
mark3_foreground {{ background }}
mark3_background {{ cyan }}

# ANSI 0 is the background and ANSI 8 is `muted`. That is Omarchy's convention
# and every template here follows it, so a theme only defines named hues.
color0  {{ background }}
color8  {{ muted }}
color1  {{ red }}
color9  {{ bright_red }}
color2  {{ green }}
color10 {{ bright_green }}
color3  {{ yellow }}
color11 {{ bright_yellow }}
color4  {{ blue }}
color12 {{ bright_blue }}
color5  {{ magenta }}
color13 {{ bright_magenta }}
color6  {{ cyan }}
color14 {{ bright_cyan }}
color7  {{ foreground }}
color15 {{ bright_foreground }}
