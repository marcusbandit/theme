# Generated by theme-set. Do not edit; edit templates/alacritty.toml.tpl.
# ~/.config/alacritty/alacritty.toml imports this file and watches its imports,
# so a re-render repaints open windows with no reload command.

[colors.primary]
background = "{{ background }}"
foreground = "{{ foreground }}"

[colors.cursor]
text = "{{ background }}"
cursor = "{{ cursor }}"

[colors.selection]
background = "{{ selection }}"
text = "{{ bright_foreground }}"

[colors.normal]
black   = "{{ background }}"
red     = "{{ red }}"
green   = "{{ green }}"
yellow  = "{{ yellow }}"
blue    = "{{ blue }}"
magenta = "{{ magenta }}"
cyan    = "{{ cyan }}"
white   = "{{ foreground }}"

[colors.bright]
black   = "{{ muted }}"
red     = "{{ bright_red }}"
green   = "{{ bright_green }}"
yellow  = "{{ bright_yellow }}"
blue    = "{{ bright_blue }}"
magenta = "{{ bright_magenta }}"
cyan    = "{{ bright_cyan }}"
white   = "{{ bright_foreground }}"
