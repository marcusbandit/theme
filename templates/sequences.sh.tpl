#!/usr/bin/env sh
# Generated by theme-set.
# Repaint ALREADY-OPEN terminals via OSC. This is a live-update trick, not
# propagation: a new window still reads the config file. Sourcing this in a
# shell rc is what makes an existing tab follow a theme switch.
printf '\033]4;0;%s\033\\'  '{{ background }}'
printf '\033]4;8;%s\033\\'  '{{ muted }}'
printf '\033]4;1;%s\033\\'  '{{ red }}'
printf '\033]4;9;%s\033\\'  '{{ bright_red }}'
printf '\033]4;2;%s\033\\'  '{{ green }}'
printf '\033]4;10;%s\033\\' '{{ bright_green }}'
printf '\033]4;3;%s\033\\'  '{{ yellow }}'
printf '\033]4;11;%s\033\\' '{{ bright_yellow }}'
printf '\033]4;4;%s\033\\'  '{{ blue }}'
printf '\033]4;12;%s\033\\' '{{ bright_blue }}'
printf '\033]4;5;%s\033\\'  '{{ magenta }}'
printf '\033]4;13;%s\033\\' '{{ bright_magenta }}'
printf '\033]4;6;%s\033\\'  '{{ cyan }}'
printf '\033]4;14;%s\033\\' '{{ bright_cyan }}'
printf '\033]4;7;%s\033\\'  '{{ foreground }}'
printf '\033]4;15;%s\033\\' '{{ bright_foreground }}'
printf '\033]10;%s\033\\'   '{{ foreground }}'
printf '\033]11;%s\033\\'   '{{ background }}'
printf '\033]12;%s\033\\'   '{{ cursor }}'
