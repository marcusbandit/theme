#!/usr/bin/env bash
# theme-reload - poke every app that is running so it picks up ~/.config/theme/current/
#
# Rule learned the hard way: NEVER rely on an app's own file watcher here.
# Hyprland watches IN_CLOSE_WRITE and so misses an atomic rename (new inode),
# while qt6ct watches its directory without IN_MODIFY and so misses an in-place
# truncate. No single write strategy satisfies both. Write the file however you
# like, then issue the explicit reload. The two exceptions below are documented
# and version checked.
#
# Every reload is guarded on the process actually running, so this is safe to
# call on a headless session or before the desktop is up.

set -uo pipefail
CUR="${THEME_ROOT:-$HOME/.config/theme}/current"
[[ -d $CUR ]] || { echo "theme-reload: no current theme" >&2; exit 1; }

run() { command -v "$1" >/dev/null 2>&1; }
alive() { pgrep -x "$1" >/dev/null 2>&1; }

pids=()

# kitty 0.47+ has auto_reload_config on by default and follows includes, so a
# rendered colours file repaints open windows with no command at all.
# Nothing to do.

# foot has no reload mechanism at all (no watcher, no signal, no IPC), but it
# honours the palette OSCs written to /dev/pts below, which repaint open
# windows. New windows re-read the config, whose include picks up the build.

# ghostty re-reads its config, includes too, on SIGUSR2 (checked on 1.4).
# One process serves every window.
alive ghostty && { pkill -USR2 -x ghostty >/dev/null 2>&1 & pids+=($!); }

# Hyprland. Note `exec =` lines re-run on every reload; only `exec-once` does not.
alive Hyprland && { hyprctl reload >/dev/null 2>&1 & pids+=($!); }

# btop reloads its theme on SIGUSR2 since 1.3.1. Keep the theme NAME stable:
# btop rewrites btop.conf on exit and would otherwise forget the selection.
alive btop && { pkill -USR2 -x btop >/dev/null 2>&1 & pids+=($!); }

# qt6ct watches ~/.config/qt6ct/ non-recursively with a 3s debounce, so touching
# only colors/*.conf is never noticed. Touch the file it does watch.
[[ -f $HOME/.config/qt6ct/qt6ct.conf ]] && { touch "$HOME/.config/qt6ct/qt6ct.conf" & pids+=($!); }
[[ -f $HOME/.config/qt5ct/qt5ct.conf ]] && { touch "$HOME/.config/qt5ct/qt5ct.conf" & pids+=($!); }

# The dark/light preference is the one standard live push channel to running
# toolkit apps. The palette itself rides in gtk.css, which GTK cannot hot reload.
if run gsettings; then
  mode=$(grep -oE '^mode *= *"[a-z]+"' "$CUR/colors.toml" | grep -oE '(dark|light)' || echo dark)
  { gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode" >/dev/null 2>&1; } &
  pids+=($!)
fi

# tmux, only if a server is up.
run tmux && tmux has-session 2>/dev/null && { tmux source-file "$CUR/tmux.conf" >/dev/null 2>&1 & pids+=($!); }

# Neovim. Each instance listens on $XDG_RUNTIME_DIR/nvim.<pid>.<n>, and there is
# no signal or config-watch path into a running one, so poke every live socket
# over RPC. A socket left behind by a dead instance simply fails to connect,
# which is why the result is discarded rather than reported.
if run nvim; then
  shopt -s nullglob
  for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*; do
    [[ -S $sock ]] || continue
    { timeout 2 nvim --server "$sock" --remote-expr \
        "luaeval(\"pcall(function() require('bandit.theme').reload() end)\")" \
        >/dev/null 2>&1 & pids+=($!); }
  done
  shopt -u nullglob
fi

# Repaint terminals that are already open. New windows read the config file, so
# this is a convenience, not the propagation path.
if [[ -r $CUR/sequences.sh ]]; then
  for pts in /dev/pts/[0-9]*; do
    [[ -w $pts ]] && sh "$CUR/sequences.sh" > "$pts" 2>/dev/null
  done
fi

# banditshell watches current/palette.json through a Quickshell FileView, so it
# needs no poke.

wait "${pids[@]}" 2>/dev/null
echo "theme-reload: done ($(cat "$CUR/theme.name" 2>/dev/null | tr -d '\n'))"
