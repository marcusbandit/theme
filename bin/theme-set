#!/usr/bin/env python3
"""
theme-set - render the active colour theme into ~/.config/theme/current/

The contract every consumer relies on:

    Nothing reads the theme NAME. Every app includes a fixed path under
    ~/.config/theme/current/ and that path never changes. Switching themes
    rewrites what lives behind that path, atomically, so no app config is
    ever edited again after it is wired once.

Usage:
    theme-set              re-render the current theme
    theme-set slate        switch to slate
    theme-set --list       list available themes
    theme-set --no-reload  render but skip the fan-out

Light or dark is separate from the theme name. It lives in ~/.config/theme/mode
and theme-mode sets it. In light mode a dark theme is turned light with the same
OKLCH curve banditshell uses, so the shell and every app agree on each colour.
"""

import fcntl
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(os.environ.get("THEME_ROOT", Path.home() / ".config/theme"))
THEMES, TEMPLATES, BUILDS = ROOT / "themes", ROOT / "templates", ROOT / "builds"
CURRENT = ROOT / "current"
STATE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "theme-set.lock"
MODE = ROOT / "mode"

# Rendered from the dark base even in light mode: banditshell reads this file
# and makes its own light version, so a light palette here would be flipped twice.
BASE_ONLY = {"palette.json.tpl"}


# ---------------------------------------------------------------- colour maths

def parse_hex(v):
    v = v.strip().lstrip("#")
    return tuple(int(v[i:i + 2], 16) for i in (0, 2, 4))


def to_hex(rgb):
    return "#%02X%02X%02X" % tuple(max(0, min(255, round(c))) for c in rgb)


def mix(a, b, t):
    """Omarchy's mix(): t is the fraction of b. Used by the derivation rules."""
    ar, ag, ab = parse_hex(a)
    br, bg, bb = parse_hex(b)
    return to_hex((ar + (br - ar) * t, ag + (bg - ag) * t, ab + (bb - ab) * t))


# Omarchy's own fallbacks, so a partial theme still resolves rather than
# rendering an empty string into somebody's config.
def derive(p):
    def need(k, fn):
        if k not in p or not p[k]:
            p[k] = fn()

    need("orange", lambda: p["yellow"])
    for hue in ("red", "green", "yellow", "blue", "magenta", "cyan"):
        need("bright_" + hue, lambda h=hue: mix(p[h], "#FFFFFF", 0.20))
    need("dark_background", lambda: mix(p["background"], "#000000", 0.25))
    need("darker_background", lambda: mix(p["background"], "#000000", 0.50))
    need("brown", lambda: mix(p["orange"], "#000000", 0.50))
    need("selection", lambda: p.get("lighter_background", p["background"]))
    need("muted", lambda: p.get("dark_foreground", p["foreground"]))
    need("bright_foreground", lambda: p["foreground"])
    need("light_foreground", lambda: p["foreground"])
    # Omarchy has no cursor key; it always resolves to bright_foreground.
    need("cursor", lambda: p["bright_foreground"])
    # Terminal window opacity, as text. Not a colour, but it is how light the
    # ground reads, so the palette owns it.
    need("opacity", lambda: "0.90")
    need("icons", lambda: "Papirus-Dark")
    return p


# ------------------------------------------------------------------ light mode
#
# A port of banditshell's config/scheme.js (lightRamp, lightAccent). Keep the
# constants in step with it, or the shell and the apps drift apart.

GROUND, INK, CURVE, PIVOT, WARNING_FLOOR = 0.96, 0.22, 1.1, 0.65, 0.52
HUE_FLOOR, HUE_CEILING, HUE_CHROMA, WARM_CHROMA = 0.30, 0.72, 1.35, 1.6
LIGHT_OPACITY = 1.0

RAMP = ["ramp_void", "ramp_abyss", "ramp_dark", "ramp_plate", "ramp_body",
        "ramp_brushed", "ramp_edge", "ramp_lit", "ramp_pale", "ramp_silver",
        "ramp_chrome"]
NEUTRAL = RAMP + ["ramp_white", "darker_background", "dark_background",
                  "background", "lighter_background", "selection", "muted",
                  "dark_foreground", "foreground", "light_foreground",
                  "bright_foreground", "border_lit", "cursor"]
HUES = ["accent", "accent_dim", "accent_mid", "accent_bright", "orange", "brown",
        "metal_ice", "metal_ice_dim"] + [
    p + h for p in ("", "bright_")
    for h in ("red", "green", "yellow", "blue", "magenta", "cyan")]
WARM = ["metal_brass", "metal_brass_dim"]


def _lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _enc(c):
    k = max(0.0, min(1.0, c))
    return 12.92 * k if k <= 0.0031308 else 1.055 * k ** (1 / 2.4) - 0.055


def to_lch(h):
    import math
    r, g, b = (_lin(c / 255) for c in parse_hex(h))
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(A, B), math.atan2(B, A)


def _raw(L, C, H):
    import math
    A, B = C * math.cos(H), C * math.sin(H)
    l = (L + 0.3963377774 * A + 0.2158037573 * B) ** 3
    m = (L - 0.1055613458 * A - 0.0638541728 * B) ** 3
    s = (L - 0.0894841775 * A - 1.2914855480 * B) ** 3
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def from_lch(L, C, H):
    ok = lambda rgb: all(-0.0001 <= v <= 1.0001 for v in rgb)
    if not ok(_raw(L, C, H)):
        lo, hi = 0.0, C
        for _ in range(20):
            mid = (lo + hi) / 2
            lo, hi = (mid, hi) if ok(_raw(L, mid, H)) else (lo, mid)
        C = lo
    return to_hex(tuple(_enc(v) * 255 for v in _raw(L, C, H)))


def lighten(p):
    """The light twin of a dark palette. Neutrals ride the inverted ramp curve,
    hues are mirrored around PIVOT so they stay readable on a pale ground."""
    q = dict(p)
    stops = [to_lch(p[k])[0] for k in RAMP if k in p]
    ground = min(stops)
    reach = max(0.0001, max(stops) - ground)
    for k in NEUTRAL:
        if k in p:
            L, C, H = to_lch(p[k])
            t = max(0.0, min(1.0, (L - ground) / reach))
            q[k] = from_lch(GROUND - (GROUND - INK) * t ** CURVE, C, H)
    for k in HUES + WARM:
        if k in p:
            L, C, H = to_lch(p[k])
            floor = WARNING_FLOOR if k in WARM else HUE_FLOOR
            q[k] = from_lch(max(floor, min(HUE_CEILING, 2 * PIVOT - L)),
                            C * (WARM_CHROMA if k in WARM else HUE_CHROMA), H)
    # A pale ground at 90% lets the wallpaper and desktop widgets show through
    # at full strength and buries the text; a dark one hides them. Light goes
    # nearly opaque.
    q["opacity"] = "%.2f" % max(float(p.get("opacity", "0.90")), LIGHT_OPACITY)
    q["icons"] = "Papirus"
    q["mode"] = "light"
    return q


def read_mode():
    try:
        m = MODE.read_text().strip()
    except OSError:
        return "dark"
    return m if m in ("dark", "light") else "dark"



# ------------------------------------------------------------------ templating

# {{ key }} {{ key_strip }} {{ key_rgb }} {{ key_argb }} {{ key_r }} ...
TOKEN = re.compile(r"\{\{\s*([a-zA-Z0-9_]+)(?:\s+([^}]*?))?\s*\}\}")
MIXCALL = re.compile(r"\{\{\s*mix(_strip|_rgb)?\s+(\S+)\s+(\S+)\s+([0-9.]+)%\s*\}\}")


def render(text, p, path):
    def do_mix(m):
        kind, a, b, pct = m.group(1), m.group(2), m.group(3), float(m.group(4))
        av = p.get(a, a)
        bv = p.get(b, b)
        out = mix(av, bv, pct / 100.0)
        if kind == "_strip":
            return out.lstrip("#")
        if kind == "_rgb":
            return ",".join(str(c) for c in parse_hex(out))
        return out

    text = MIXCALL.sub(do_mix, text)

    def do_token(m):
        raw = m.group(1)
        for suffix, fn in (
            ("_strip", lambda h: h.lstrip("#")),
            ("_argb", lambda h: "#ff" + h.lstrip("#").lower()),
            ("_rgb", lambda h: ",".join(str(c) for c in parse_hex(h))),
            ("_rgbspace", lambda h: " ".join(str(c) for c in parse_hex(h))),
            ("_r", lambda h: str(parse_hex(h)[0])),
            ("_g", lambda h: str(parse_hex(h)[1])),
            ("_b", lambda h: str(parse_hex(h)[2])),
            ("_lower", lambda h: h.lower()),
        ):
            if raw.endswith(suffix):
                key = raw[: -len(suffix)]
                if key in p:
                    return fn(p[key])
        if raw in p:
            return p[raw]
        # A typo in a template must be loud, not silently blank.
        raise KeyError(f"{path.name}: unknown key '{raw}'")

    return TOKEN.sub(do_token, text)


# ----------------------------------------------------------------------- build

def load(name):
    f = THEMES / name / "colors.toml"
    if not f.exists():
        sys.exit(f"theme-set: no such theme '{name}' ({f} missing)")
    with f.open("rb") as fh:
        p = {k: v for k, v in tomllib.load(fh).items() if isinstance(v, str)}
    p["theme_name"] = name
    return derive(p), f


def write_index(out):
    """Publish every theme on disk, so a picker can list and preview them all
    without parsing toml itself. The active one is named in theme.name."""
    import json
    entries = []
    for d in sorted(THEMES.iterdir()):
        cf = d / "colors.toml"
        if not cf.exists():
            continue
        try:
            with cf.open("rb") as fh:
                q = {k: v for k, v in tomllib.load(fh).items() if isinstance(v, str)}
        except Exception:
            continue
        entries.append({
            "name": d.name,
            "mode": q.get("mode", "dark"),
            "dim": q.get("accent_dim", q.get("accent", "#000000")),
            "mid": q.get("accent_mid", q.get("accent", "#000000")),
            "bright": q.get("accent_bright", q.get("accent", "#000000")),
            "alarm": q.get("orange", "#000000"),
            "background": q.get("background", "#000000"),
            "foreground": q.get("foreground", "#FFFFFF"),
        })
    (out / "themes.json").write_text(json.dumps(entries, indent=2) + "\n")


def build(name):
    base, src = load(name)
    mode = read_mode()
    p = lighten(base) if mode == "light" and base.get("mode") != "light" else base
    stamp = f"{name}-{int(time.time() * 1000)}"
    out = BUILDS / stamp
    out.mkdir(parents=True)

    rendered = []
    for tpl in sorted(TEMPLATES.glob("*.tpl")):
        target = out / tpl.name[:-4]
        target.parent.mkdir(parents=True, exist_ok=True)
        src_p = base if tpl.name in BASE_ONLY else p
        target.write_text(render(tpl.read_text(), src_p, tpl))
        rendered.append(target.name)

    # Ship the palette too, so a consumer can read values we did not
    # anticipate a template for. In light mode that is the lightened one.
    if p is base:
        shutil.copy(src, out / "colors.toml")
    else:
        (out / "colors.toml").write_text(
            f"# {name}, lightened by theme-set. Edit themes/{name}/colors.toml.\n"
            + "".join(f'{k} = "{v}"\n' for k, v in p.items() if k != "theme_name"))
    (out / "theme.name").write_text(name + "\n")
    (out / "theme.mode").write_text(p.get("mode", "dark") + "\n")
    write_index(out)

    # Atomic: point the symlink at the finished directory in one rename.
    tmplink = ROOT / f".current.{os.getpid()}"
    tmplink.symlink_to(out)
    os.replace(tmplink, CURRENT)

    for old in BUILDS.iterdir():
        if old.is_dir() and old != out:
            shutil.rmtree(old, ignore_errors=True)

    return name, rendered


def main():
    args = [a for a in sys.argv[1:]]
    if "--list" in args:
        for d in sorted(THEMES.iterdir()):
            if (d / "colors.toml").exists():
                print(d.name)
        return
    no_reload = "--no-reload" in args
    args = [a for a in args if not a.startswith("--")]

    if args:
        name = args[0]
    elif (CURRENT / "theme.name").exists():
        name = (CURRENT / "theme.name").read_text().strip()
    else:
        sys.exit("theme-set: no theme given and none active")

    BUILDS.mkdir(parents=True, exist_ok=True)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    lock = open(STATE, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        name, rendered = build(name)
    finally:
        # Release before the slow fan-out, so a rapid second switch only ever
        # waits on the render, never on a reload.
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()

    print(f"theme-set: {name}, {read_mode()} ({len(rendered)} files)")
    if not no_reload:
        r = ROOT / "bin" / "theme-reload"
        if r.exists():
            subprocess.run([str(r)], check=False)


if __name__ == "__main__":
    main()
